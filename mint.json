{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Quark",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png"
  },
  "favicon": "/images/quark.png",
  "colors": {
    "primary": "#c336c3",
    "light": "#9b2b9b",
    "dark": "#ce4dce",
    "anchors": {
      "from": "#ce4dce",
      "to": "#9b2b9b"
    }
  },
  "api": {
    "baseUrl": "https://quark.bot/api",
    "auth": {
      "method": "bearer"
    }
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "topbarLinks": [
    {
      "name": "Support",
      "url": "https://quark.bot/support"
    }
  ],
  "topbarCtaButton": {
    "name": "Dashboard",
    "url": "https://quark.bot/dashboard"
  },
  "anchors": [
    {
      "name": "Website",
      "icon": "book-open-cover",
      "url": "https://quark.bot"
    },
    {
      "name": "Support",
      "icon": "discord",
      "url": "https://quark.bot/support"
    },
    {
      "name": "GitHub",
      "icon": "github",
      "url": "https://quark.bot/github"
    },
    {
      "name": "Invite",
      "icon": "plus",
      "url": "https://quark.bot/api/invite?source=docs"
    },
    {
      "name": "Subscriptions",
      "icon": "ranking-star",
      "url": "https://quark.bot/subscriptions"
    },
    {
      "name": "Edit Docs",
      "icon": "pencil",
      "url": "https://github.com/quark-bot-discord/docs"
    }
  ],
  "navigation": [
    {
      "group": "API Reference",
      "pages": [
        "api-reference/introduction"
      ]
    }
  ],
  "footerSocials": {
    "discord": "https://quark.bot/support",
    "github": "https://github.com/quark-bot-discord"
  },
  "tabs": [
    {
      "name": "API Reference",
      "url": "api-reference",
      "openapi": "/api-reference/openapi.json"
    }
  ]
}