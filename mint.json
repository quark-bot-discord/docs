{
  "$schema": "https://mintlify.com/schema.json",
  "name": "Quark",
  "logo": {
    "dark": "/logo/dark.png",
    "light": "/logo/light.png"
  },
  "favicon": "/images/quark.png",
  "colors": {
    "primary": "#c336c3",
    "light": "#9b2b9b",
    "dark": "#ce4dce",
    "anchors": {
      "from": "#ce4dce",
      "to": "#9b2b9b"
    }
  },
  "api": {
    "baseUrl": "https://quark.bot/api",
    "auth": {
      "method": "bearer"
    }
  },
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "topbarLinks": [
    {
      "name": "Support",
      "url": "https://quark.bot/support"
    }
  ],
  "topbarCtaButton": {
    "name": "Dashboard",
    "url": "https://quark.bot/dashboard"
  },
  "anchors": [
    {
      "name": "Website",
      "icon": "book-open-cover",
      "url": "https://quark.bot"
    },
    {
      "name": "Support",
      "icon": "discord",
      "url": "https://quark.bot/support"
    },
    {
      "name": "Status",
      "icon": "signal",
      "url": "https://status.quark.bot"
    },
    {
      "name": "Changelog",
      "icon": "clock-rotate-left",
      "url": "https://quark.bot/changelog"
    },
    {
      "name": "GitHub",
      "icon": "github",
      "url": "https://quark.bot/github"
    },
    {
      "name": "Invite",
      "icon": "plus",
      "url": "https://quark.bot/api/invite?source=docs"
    },
    {
      "name": "Pricing",
      "icon": "ranking-star",
      "url": "https://quark.bot/pricing"
    },
    {
      "name": "Edit Docs",
      "icon": "pencil",
      "url": "https://github.com/quark-bot-discord/docs"
    }
  ],
  "navigation": [
    {
      "group": "Get Started",
      "pages": [
        "introduction",
        "quickstart",
        "overview",
        "permissions",
        "troubleshooting",
        "ideas"
      ]
    },
    {
      "group": "Dashboard",
      "pages": [
        "dashboard/overview",
        "dashboard/formats",
        "dashboard/automations",
        "dashboard/access"
      ]
    },
    {
      "group": "Logs",
      "pages": [
        "logs/overview",
        "logs/types",
        "logs/behaviour",
        "logs/options",
        "logs/customization",
        "logs/viewer",
        "logs/search",
        "logs/integrations"
      ]
    },
    {
      "group": "Commands",
      "pages": [
        "commands/overview",
        "commands/list",
        "commands/behaviour",
        "commands/tags"
      ]
    },
    {
      "group": "Subscriptions",
      "pages": [
        "subscriptions/overview",
        "subscriptions/comparison",
        "subscriptions/manage",
        "subscriptions/voting"
      ]
    },
    {
      "group": "Data",
      "pages": [
        "data/overview",
        "data/behaviour",
        "data/storage"
      ]
    },
    {
      "group": "Languages",
      "pages": [
        "languages/overview",
        "languages/start-translating",
        "languages/add-language"
      ]
    },
    {
      "group": "API Reference",
      "pages": [
        "api-reference/introduction"
      ]
    }
  ],
  "footerSocials": {
    "discord": "https://quark.bot/support",
    "github": "https://github.com/quark-bot-discord"
  },
  "tabs": [
    {
      "name": "API Reference",
      "url": "api-reference",
      "openapi": "/api-reference/openapi.json"
    }
  ],
  "redirects": [
    {
      "source": "/subscriptions",
      "destination": "/subscriptions/overview"
    },
    {
      "source": "/commands",
      "destination": "/commands/overview"
    },
    {
      "source": "/logs",
      "destination": "/logs/overview"
    },
    {
      "source": "/data",
      "destination": "/data/overview"
    },
    {
      "source": "/languages",
      "destination": "/languages/overview"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/overview"
    }
  ]
}
